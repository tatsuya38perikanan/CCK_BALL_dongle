if SHIELD_CCK_BALL_DONGLE

config ZMK_KEYBOARD_NAME
	default "WK CCK BALL"

config ZMK_SPLIT_BLE_ROLE_CENTRAL
	default y

config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
	default 2

if ZMK_DISPLAY

config I2C
	default y

config SSD1306
	default y

endif # ZMK_DISPLAY

endif # SHIELD_CCK_BALL_DONGLE

if SHIELD_CCK_BALL_LEFT || SHIELD_CCK_BALL_RIGHT || SHIELD_CCK_BALL_DONGLE

