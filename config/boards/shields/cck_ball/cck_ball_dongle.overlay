#include <dt-bindings/zmk/matrix_transform.h>
#include "cck_ball-layouts.dtsi"

/ {
	chosen {
		zmk,kscan = &mock_kscan;
		zmk,physical-layouts = &cck_ball_layouts;
		zephyr,display = &oled;
	};

	mock_kscan: mock_kscan_0 {
		compatible = "zmk,kscan-mock";
		columns = <0>;
		rows = <0>;
		events = <0>;
	};

	default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <12>;
		rows = <5>;
		map = <
RC(0,5) RC(0,4) RC(0,3) RC(0,2) RC(0,1) RC(0,0) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
RC(1,5) RC(1,4) RC(1,3) RC(1,2) RC(1,1) RC(1,0) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,5) RC(2,4) RC(2,3) RC(2,2) RC(2,1) RC(2,0) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
RC(3,5) RC(3,4) RC(3,3) RC(3,2) RC(3,1) RC(3,0) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
RC(4,5) RC(4,4) RC(4,3) RC(4,2) RC(4,1) RC(4,0) RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11)
		>;
	};

	/* encoders: 実体は左右のキーボード側。ここでは宣言だけ（disabled） */
	left_encoder: encoder_left {
		compatible = "alps,ec11";
		status = "disabled";
		label = "LEFT_ENCODER";
		a-gpios = <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		b-gpios = <&gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		steps = <24>;
		pulses-per-detent = <2>;
	};

	right_encoder: encoder_right {
		compatible = "alps,ec11";
		status = "disabled";
		label = "RIGHT_ENCODER";
		a-gpios = <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		b-gpios = <&gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		steps = <24>;
		pulses-per-detent = <2>;
	};

	sensors {
		compatible = "zmk,keymap-sensors";
		sensors = <&left_encoder &right_encoder>;
		triggers-per-rotation = <24>;
	};

	/* trackball: 右側から転送されてくる入力を受け取る */
	split_inputs {
		#address-cells = <1>;
		#size-cells = <0>;

		trackball_split: trackball_split@0 {
			compatible = "zmk,input-split";
			reg = <0>;
		};
	};

	trackball_listener: trackball_listener {
		compatible = "zmk,input-listener";
		device = <&trackball_split>;

		scroll {
			layers = <3>;
			input-processors = <&zip_xy_to_scroll_mapper>;
		};

		snipe {
			layers = <4>;
			input-processors = <&zip_xy_scaler 1 2>;
		};
	};
};

&pro_micro_i2c {
	status = "okay";

	oled: oled@3c {
		compatible = "sinowealth,sh1106";
		reg = <0x3c>;
		width = <128>;
		height = <64>;
		segment-offset = <2>;
		page-offset = <0>;
		display-offset = <0>;
		multiplex-ratio = <63>;
		segment-remap;
		com-invdir;
		prechargep = <0x22>;
	};
};